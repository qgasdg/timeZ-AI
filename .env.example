# 강의계획서 수집 스크립트(logic/convert/download_*.py, http_to_json.py)
# 브라우저로 sugang.inha.ac.kr에 로그인한 뒤 ASP.NET_SessionId 쿠키 값을 넣는다
INHA_SESSION_ID=

# 수집 파일을 내려받을 폴더 (기본값: ~/Downloads)
DOWNLOAD_DIR=

# 노트북에서 os.chdir 할 레포 루트 (기본값: 노트북 위치 기준 상대경로)
PROJECT_ROOT=

# OpenAI 임베딩(logic/recommendation/embedding.py)
OPENAI_API_KEY=
